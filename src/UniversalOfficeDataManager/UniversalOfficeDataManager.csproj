<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <Nullable>enable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <LangVersion>latest</LangVersion>
    <RootNamespace>UniversalOfficeDataManager</RootNamespace>
    <AssemblyName>UniversalOfficeDataManager</AssemblyName>
    <Version>0.1.0-stage1</Version>
    <Company>Universal Office Data Manager</Company>
    <Product>Universal Office Data Manager</Product>
    <Description>Offline-first universal data management desktop app.</Description>
    <GenerateAssemblyInfo>true</GenerateAssemblyInfo>
    <InvariantGlobalization>false</InvariantGlobalization>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Data.Sqlite" Version="10.0.11" />
  </ItemGroup>

</Project>

<Window x:Class="UniversalOfficeDataManager.Views.FieldEditWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Field" Height="460" Width="400"
        WindowStartupLocation="CenterOwner" ResizeMode="NoResize">
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" Text="Field Name" FontWeight="SemiBold" Margin="0,0,0,4"/>
        <TextBox Grid.Row="1" x:Name="NameBox" Padding="6"/>

        <TextBlock Grid.Row="2" Text="Field Type" FontWeight="SemiBold" Margin="0,14,0,4"/>
        <ComboBox Grid.Row="3" x:Name="TypeCombo" Padding="6" SelectionChanged="TypeCombo_SelectionChanged"/>

        <CheckBox Grid.Row="4" x:Name="RequiredCheck" Content="Required field" Margin="0,16,0,0"/>

        <TextBlock Grid.Row="5" Text="Default Value (optional)" FontWeight="SemiBold" Margin="0,14,0,4"/>
        <TextBox Grid.Row="6" x:Name="DefaultValueBox" Padding="6"/>

        <StackPanel Grid.Row="7" x:Name="OptionsPanel" Margin="0,14,0,0">
            <TextBlock Text="Dropdown Options (comma-separated)" FontWeight="SemiBold" Margin="0,0,0,4"/>
            <TextBox x:Name="OptionsBox" Padding="6"/>
        </StackPanel>

        <StackPanel Grid.Row="9" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,16,0,0">
            <Button Content="Cancel" Width="90" Margin="0,0,8,0" IsCancel="True" Click="Cancel_Click"/>
            <Button Content="Save" Width="90" IsDefault="True" Click="Save_Click" Style="{StaticResource PrimaryButtonStyle}"/>
        </StackPanel>
    </Grid>
</Window>

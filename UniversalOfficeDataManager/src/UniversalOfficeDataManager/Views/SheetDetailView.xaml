<UserControl x:Class="UniversalOfficeDataManager.Views.SheetDetailView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,16">
            <TextBlock Text="{Binding Sheet.Name}" FontSize="22" FontWeight="Bold" VerticalAlignment="Center"/>
            <Button Content="Manage Fields" Margin="24,0,0,0" Command="{Binding ManageFieldsCommand}"/>
            <Button Content="Add Record" Margin="8,0,0,0" Command="{Binding AddRecordCommand}" Style="{StaticResource PrimaryButtonStyle}"/>
            <Button Content="Edit" Margin="8,0,0,0" Command="{Binding EditRecordCommand}"/>
            <Button Content="Delete" Margin="8,0,0,0" Command="{Binding DeleteRecordCommand}"/>
            <Button Content="Refresh" Margin="8,0,0,0" Command="{Binding RefreshCommand}"/>
        </StackPanel>

        <DataGrid x:Name="RecordsGrid" Grid.Row="1"
                  ItemsSource="{Binding Rows}"
                  SelectedItem="{Binding SelectedRow}"
                  AutoGenerateColumns="False"
                  IsReadOnly="True"
                  CanUserAddRows="False"
                  GridLinesVisibility="Horizontal"
                  HeadersVisibility="Column"
                  RowHeaderWidth="0"
                  AlternatingRowBackground="#F8FAFC"
                  BorderThickness="1"
                  BorderBrush="{StaticResource BorderBrushColor}">
            <DataGrid.InputBindings>
                <MouseBinding MouseAction="LeftDoubleClick" Command="{Binding EditRecordCommand}"/>
            </DataGrid.InputBindings>
        </DataGrid>
    </Grid>
</UserControl>

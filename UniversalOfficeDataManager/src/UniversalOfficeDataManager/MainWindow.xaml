<Window x:Class="UniversalOfficeDataManager.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:UniversalOfficeDataManager.ViewModels"
        xmlns:views="clr-namespace:UniversalOfficeDataManager.Views"
        Title="Universal Office Data Manager" Height="800" Width="1280"
        MinHeight="600" MinWidth="960"
        WindowStartupLocation="CenterScreen"
        Background="{StaticResource ContentBackgroundBrush}">

    <Window.InputBindings>
        <KeyBinding Modifiers="Ctrl+Shift" Key="N" Command="{Binding AddWorkspaceCommand}"/>
    </Window.InputBindings>

    <Window.Resources>
        <DataTemplate DataType="{x:Type vm:DashboardViewModel}">
            <views:DashboardView/>
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:SheetDetailViewModel}">
            <views:SheetDetailView/>
        </DataTemplate>
    </Window.Resources>

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="270"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- Sidebar -->
        <Border Grid.Column="0" Background="{StaticResource SidebarBackgroundBrush}">
            <DockPanel LastChildFill="True">

                <StackPanel DockPanel.Dock="Top" Margin="20,20,20,10">
                    <TextBlock Text="Universal Office" FontSize="18" FontWeight="Bold" Foreground="White"/>
                    <TextBlock Text="Data Manager" FontSize="18" FontWeight="Bold" Foreground="{StaticResource AccentBrush}"/>
                </StackPanel>

                <Button DockPanel.Dock="Top" Content="Dashboard" Margin="16,10,16,10"
                        Command="{Binding ShowDashboardCommand}"
                        Style="{StaticResource SidebarButtonStyle}"/>

                <Grid DockPanel.Dock="Top" Margin="16,10,16,4">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="WORKSPACES" Foreground="#94A3B8" FontSize="11" FontWeight="Bold" VerticalAlignment="Center"/>
                    <Button Grid.Column="1" Content="+ New" Command="{Binding AddWorkspaceCommand}"
                            Style="{StaticResource SidebarLinkButtonStyle}"/>
                </Grid>

                <TreeView x:Name="WorkspaceTree" DockPanel.Dock="Top" ItemsSource="{Binding Workspaces}"
                          Background="Transparent" BorderThickness="0" Margin="8,0,8,8"
                          SelectedItemChanged="WorkspaceTree_SelectedItemChanged">
                    <TreeView.Resources>

                        <HierarchicalDataTemplate DataType="{x:Type vm:WorkspaceNodeViewModel}" ItemsSource="{Binding Sheets}">
                            <Grid Margin="0,4">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <Grid.ContextMenu>
                                    <ContextMenu>
                                        <MenuItem Header="Add Sheet" Click="AddSheetMenuItem_Click"/>
                                        <MenuItem Header="Rename Workspace" Click="RenameWorkspaceMenuItem_Click"/>
                                        <MenuItem Header="Delete Workspace" Click="DeleteWorkspaceMenuItem_Click"/>
                                    </ContextMenu>
                                </Grid.ContextMenu>
                                <TextBlock Grid.Column="0" Text="{Binding Name}" Foreground="White"
                                           FontWeight="SemiBold" VerticalAlignment="Center"/>
                                <Button Grid.Column="1" Content="+ Sheet"
                                        Command="{Binding DataContext.AddSheetCommand, RelativeSource={RelativeSource AncestorType=TreeView}}"
                                        CommandParameter="{Binding}"
                                        Style="{StaticResource SidebarLinkButtonStyle}"/>
                            </Grid>
                            <HierarchicalDataTemplate.ItemContainerStyle>
                                <Style TargetType="TreeViewItem">
                                    <Setter Property="IsExpanded" Value="{Binding IsExpanded, Mode=TwoWay}"/>
                                </Style>
                            </HierarchicalDataTemplate.ItemContainerStyle>
                        </HierarchicalDataTemplate>

                        <DataTemplate DataType="{x:Type vm:SheetNodeViewModel}">
                            <Grid Margin="8,4">
                                <Grid.ContextMenu>
                                    <ContextMenu>
                                        <MenuItem Header="Rename Sheet" Click="RenameSheetMenuItem_Click"/>
                                        <MenuItem Header="Delete Sheet" Click="DeleteSheetMenuItem_Click"/>
                                    </ContextMenu>
                                </Grid.ContextMenu>
                                <TextBlock Text="{Binding Name}" Foreground="#CBD5E1" VerticalAlignment="Center"/>
                            </Grid>
                        </DataTemplate>

                    </TreeView.Resources>
                </TreeView>

                <TextBlock DockPanel.Dock="Bottom" Text="Stage 1 — 100% offline"
                           Foreground="#475569" FontSize="10" Margin="16,8" HorizontalAlignment="Center"/>
            </DockPanel>
        </Border>

        <!-- Content -->
        <ContentControl Grid.Column="1" Content="{Binding CurrentView}"/>
    </Grid>
</Window>
